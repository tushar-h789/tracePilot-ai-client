# TracePilot AI client — copy to .env.local (gitignored). Placeholders only; never commit real values.

# Server-side only (read at request time by Server Components). NOT exposed to the browser.
# Local dev against `docker compose up` in the server repo:
API_BASE_URL=http://localhost:8000/api/v1
# In Docker Compose (web profile) this is set to http://api:8000/api/v1 by docker-compose.yml.

# There is intentionally no NEXT_PUBLIC_API_BASE_URL: the browser never calls the API directly.
